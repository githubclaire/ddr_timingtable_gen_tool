import os
import subprocess
import argparse

def check_gcc_installed() -> bool:
    try:
        subprocess.run(
            ["gcc", "--version"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=True
        )
        return True
    except (FileNotFoundError, subprocess.CalledProcessError):
        return False

def compile_test_c(ddr_type: str, two_channel: str, density: int, exec_file: str = "ddr_config_bin_exec",
                   freq_level: int = 0, default_ch: int = 0, byte_mode: int = 0,
                   mixed: int = 0, dq_width: int = 16,
                   lp5_freq_set: str = "6000") -> bool:

    if not os.path.exists("ddr_config_bin.c"):
        print("error: ddr_config_bin.c not found in current directory")
        return False

    # P2-7: header search path used to be hardcoded to the upstream checkout
    # layout (../../arise2_gpu/...). Accept overrides via $DDR_HEADER_DIRS
    # (colon-separated) so external drivers can point at their own include
    # tree without patching this script.
    header_dirs = ["./"]
    extra = os.environ.get("DDR_HEADER_DIRS", "")
    if extra:
        header_dirs.extend(p for p in extra.split(":") if p)

    gcc_command = [
        "gcc",
        "-std=c99",
        "-D", f"DDR_TYPE={ddr_type}",
        "-D", f"DDR_TWO_CHANNEL={two_channel}",
        "-D", f"ORBIT_DENSITY={density}",
        "-D", f"DDR_FREQ_LEVEL={freq_level}",
        "-D", f"DDR_DEFAULT_CH={default_ch}",
        "-D", f"ORBIT_BYTE_MODE={byte_mode}",
        "-D", f"ORBIT_MIXED={mixed}",
        "-D", f"ORBIT_DQ_WIDTH={dq_width}",
    ]
    if str(lp5_freq_set) == "6400":
        gcc_command.extend(["-D", "ORBIT_LP5_FREQ_SET_6400=1"])
    for h in header_dirs:
        gcc_command.extend(["-I", h])
    gcc_command += ["ddr_config_bin.c", "-o", exec_file]

    try:
        compile_result = subprocess.run(
            gcc_command,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            check=True
        )

        os.chmod(exec_file, 0o755)

        if os.path.exists(exec_file):
            return True
        else:
            print("compile failed: executable not produced")
            return False
    except subprocess.CalledProcessError as e:
        print(f"compile error:\n{e.output}")
        return False

def run_executable(exec_file: str = "ddr_config_bin_exec") -> bool:

    if not os.path.exists(exec_file):
        print(f"error: executable {exec_file} not found")
        return False

    try:
        subprocess.run(
            [f"./{exec_file}"],
            check=True
        )
        return True
    except subprocess.CalledProcessError as e:
        print(f"ddr_config generation failed: return code {e.returncode}")
        return False

def main():
    parser = argparse.ArgumentParser(description="compile and generate ddr_config")
    parser.add_argument("macro_ddr_type", help="DDR_TYPE macro value")
    parser.add_argument("macro_two_channel", help="DDR_TWO_CHANNEL macro value (e.g. 2)")
    parser.add_argument("--density", type=int, default=None, help="density (Gb); read from orbit_init_gen.h if unset")
    parser.add_argument("--freq-level", type=int, default=0, choices=[0, 1, 2, 3],
                        help="DDR_FREQ_LEVEL (drops that many fastest points)")
    parser.add_argument("--default-ch", type=int, default=0, choices=[0, 1],
                        help="single-channel default OMC (0 or 1)")
    parser.add_argument("--byte-mode", type=int, default=0, choices=[0, 1],
                        help="orbit byte mode (0=x16, 1=x8)")
    parser.add_argument("--mixed", type=int, default=0, choices=[0, 1],
                        help="mixed rank density flag")
    parser.add_argument("--dq-width", type=int, default=16, choices=[4, 8, 16, 32],
                        help="per-device DQ width stored in orbit_config")
    parser.add_argument("--lp5-freq-set", default="6000", choices=["6000", "6400"],
                        help="LPDDR5 boot frequency table")
    parser.add_argument("--clean", action="store_true", help="remove the executable after running")

    args = parser.parse_args()

    if not check_gcc_installed():
        print("error: gcc not found; please install it (e.g. sudo apt install gcc)")
        return

    ddr_type = args.macro_ddr_type
    two_channel = args.macro_two_channel
    
    # Try to read density from orbit_init_gen.h if not provided
    density = args.density
    if density is None:
        if os.path.exists('orbit_init_gen.h'):
            try:
                with open('orbit_init_gen.h', 'r') as f:
                    content = f.read()
                    import re
                    match = re.search(r'#define\s+DEFAULT_DENSITY\s+(\d+)', content)
                    if match:
                        density = int(match.group(1))
                        print(f"Read density from orbit_init_gen.h: {density}")
            except Exception as e:
                print(f"Warning: Failed to read orbit_init_gen.h: {e}")
        if density is None:
            density = 16
            print(f"Using default density: {density}")
    else:
        print(f"Using density from command line: {density}")

    exec_file = "ddr_config_bin_exec"
    # ddr_config.h is generated from the checked-in template (gitignored).
    if not os.path.exists("ddr_config.h") and os.path.exists("ddr_config.h.template"):
        import shutil
        shutil.copyfile("ddr_config.h.template", "ddr_config.h")
    if not compile_test_c(ddr_type, two_channel, density, exec_file,
                          freq_level=args.freq_level,
                          default_ch=args.default_ch,
                          byte_mode=args.byte_mode,
                          mixed=args.mixed,
                          dq_width=args.dq_width,
                          lp5_freq_set=args.lp5_freq_set):
        return

    run_success = run_executable(exec_file)

    if args.clean and os.path.exists(exec_file):
        os.remove(exec_file)

if __name__ == "__main__":
    main()