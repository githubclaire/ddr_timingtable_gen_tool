            self.t_xp = self.p_t_xp.calc_ceil(t_ck)
            self.t_rc = self.p_t_rc.calc_ceil(t_ck)
            self.t_ras = self.p_t_ras.calc_ceil(t_ck)
            self.t_rtp = self.p_t_rtp.calc_ceil(t_ck)
