    def write(self):
        parameters = OrderedDict({
                'OMC_NUM_TIMING_PARAMS': 21,
                'OMC_NUM_DERATE_PARAMS': 2,
                'OMC_NUM_DFI_TIMING_PARAMS': 8,
                'OMC_NUM_DENSITIES': len(self.densities),
                })

        with open(args.output, 'w') as f:
            f.write('struct timing_param timing_params[] = {\n')
            f.write(',\n'.join([x.replace('\n', '').replace(' ', '') for x in self.c_values]))
            f.write('\n};\n')

        # For orbit config, density is fixed to 16 per customer spec.
        # Ensure density 16 is in the mapping even if not in timing densities.
        orbit_densities = list(self.densities)
        if 16 not in orbit_densities:
            orbit_densities.append(16)
        
        with open('orbit_init_gen.h', 'w') as f:
            f.write('#ifndef __ORBIT_INIT_GEN__\n')
            f.write('#define __ORBIT_INIT_GEN__\n')
            f.write('\n')
            for idx, d in enumerate(orbit_densities):
                f.write('#define DENSITY_{:d}    {:d}\n'.format(d, idx))
            f.write('typedef unsigned int omc_dram_density_t;\n')
            
            f.write('\n#ifdef _ORBIT_GET_DENSITY_\n')
            f.write('\nomc_dram_density_t get_density_code(unsigned int density) {\n')
            f.write('  switch (density) {\n')
            f.write('\n'.join(['    case {d:d}: return DENSITY_{d:d};'.format(d=d) for d in orbit_densities]))
            f.write('\n    default: /* add error handling code */ return DENSITY_{:d};\n'.format(orbit_densities[0]))
            f.write('  }\n')
            f.write('}\n')
            f.write('#endif\n')
            f.write('#endif\n')

        with open('mr_config_gen.h', 'w') as f:
            f.write('#define LPDDR4_WDQS_CTRL_MODE {}\n'.format(int(self.args.wdqs_ctrl_mode)))
            f.write('#define LPDDR5_ENHANCED_NT_ODT {}\n'.format(int(self.args.enhanced_nt_odt)))
            f.write('\n'.join(['#define {key:s} {var:d}'.format(key=key,var=var) for key, var in parameters.items()]))

