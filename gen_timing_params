    def delay_t_rcd(self,t_ck,t_rcd,t_rrd):
        #print(t_ck, "Before calculation - t_rcd", t_rcd, "t_rrd", t_rrd)

        if self.args.dram_type == 'lpddr4':
            t_rcd2 = ceil(t_rcd/4)
            t_rrd2 = ceil(t_rrd/4)
        elif self.args.omc_freq_ratio == 2:
            t_rcd2 = ceil(t_rcd/2)
            t_rrd2 = ceil(t_rrd/2)
        else:
            t_rcd2 = t_rcd
            t_rrd2 = t_rrd

        if ( (t_rcd2 // 2 == t_rrd2) or (t_rcd2 // 3 == t_rrd2) or (t_rcd2 // 4 == t_rrd2) ):
            if self.args.dram_type == 'lpddr4':
                t_rcd += 4
            else:
                t_rcd += self.args.omc_freq_ratio
        #print(t_ck, "After modification - t_rcd", t_rcd, "t_rrd", t_rrd, t_rcd2, t_rrd2)

        return t_rcd

    def calculate(self):
        self.c_values = []

        for t_ck in self.args.periods:
            # In case of LPDDR5, t_ck means tWCK until dram.update() is called
            #                    before dram.update(), t_ck is modified again
            self.t_wck = t_ck

            self.geardown_mode = self.args.geardown_upto >= t_ck
            self.write_odt = self.args.write_odt_upto >= t_ck
            self.write_odt_cr = self.args.dram_type not in ('lpddr4', 'lpddr5') and self.write_odt
            self.write_dbi = self.args.dram_type in ('ddr4', 'lpddr4', 'lpddr5') and self.args.write_dbi_upto >= t_ck
            self.read_dbi = self.args.dram_type in ('ddr4', 'lpddr4', 'lpddr5') and self.args.read_dbi_upto >= t_ck
            self.write_lecc = self.args.dram_type in ('lpddr5', ) and self.args.write_lecc_upto > t_ck
            self.read_lecc = self.args.dram_type in ('lpddr5', ) and self.args.read_lecc_upto > t_ck
            self.rpste = args.rpste_upto >= t_ck
            self.wpste = args.wpste_upto >= t_ck

            self.nt_odt = self.args.nt_odt_upto >= t_ck
            self.bg_mode = self.args.bg_mode_upto >= t_ck
            self.wck_1to4 = self.args.wck_1to4_upto >= t_ck
            self.wck_hf = self.args.wck_hf_upto >= t_ck
            wck_always_on_from = 1000000 if self.args.wck_always_on_from == 0 else self.args.wck_always_on_from
            wck_always_on_upto = 1000000 if self.args.wck_always_on_upto == 0 else self.args.wck_always_on_upto
            self.wck_always_on = wck_always_on_from >= t_ck and wck_always_on_upto <= t_ck
            self.emulation = self.args.emulation
            if self.args.wck_pst2_upto >= t_ck:
                self.wck_pst = 2
            elif self.args.wck_pst1_upto >= t_ck:
                self.wck_pst = 1
            else:
                self.wck_pst = 0

            if self.args.rdqs_pst2_upto >= t_ck:
                self.rdqs_pst = 2
            elif self.args.rdqs_pst1_upto >= t_ck:
                self.rdqs_pst = 1
            else:
                self.rdqs_pst = 0
            self.rdqs_pst_mode = 0
            self.rdqs_pre = 0

            if not self.has_converter:
                self.pipe_freq_ratio = 1
            else:
                self.pipe_freq_ratio = 2

            if self.args.dram_type == 'lpddr5':
                if self.wck_1to4:
                    self.data_freq_ratio = 4
                else:
                    self.data_freq_ratio = 2
                self.tphy_wrdata = self.data_freq_ratio
            else:
                self.data_freq_ratio = 2
                self.tphy_wrdata = 2

            self.min_t_ck = self.args.min_dram_tck * self.data_freq_ratio
            self.tctrl_delay = 4

            self.phy.update_conf(t_ck)

            self.tphy_rdlat = 4
            self.tphy_wrcslat = 0

            self.tdram_clk_disable = 4
            self.tdram_clk_enable = 4
            self.pipe_depth_diff = args.dpipe_depth - args.cpipe_depth
            self.pipe_delay = self.pipe_depth_diff*2*self.pipe_freq_ratio
            self.tlp_resp = 16
            self.tphyupd_req_dis = 0

            if self.has_converter:
                self.tctrl_delay += 4
            if self.args.meso_synchronizer:
                self.tctrl_delay += 4

            self.twrdata_delay = self.pipe_delay \
                                 + (32 if self.args.dram_type == 'lpddr4' or self.args.dram_type == 'lpddr5' else 8)//2 \
                                 + (self.wpste+1) \
                                 + ((self.tphy_wrdata//self.data_freq_ratio) if self.args.dram_type == 'lpddr5' else self.tphy_wrdata)
            if self.has_converter:
                self.twrdata_delay += self.args.phy_freq_ratio
            if args.meso_synchronizer:
                self.twrdata_delay += 4*self.args.phy_freq_ratio

            # in case of LPDDR5. input t_ck is tWCK and output t_ck is tCK
            if self.args.dram_type == 'lpddr5':
                t_ck *= self.data_freq_ratio

            self.t_rfcpb = OrderedDict()
            self.t_rfcab = OrderedDict()
            self.t_rfmpb = OrderedDict()
            self.t_rfmab = OrderedDict()
            self.t_refdpr = OrderedDict()
            self.t_pbr2pbr = OrderedDict()
            self.tx_pbr2pbr = OrderedDict()
            self.t_xsr = OrderedDict()
            self.t_xsdll = OrderedDict()
            self.t_xs_fast = OrderedDict()

            for d in self.densities:
                self.t_rfcab[d] = self.p_t_rfcab[d].calc_ceil(t_ck)
                self.t_rfmab[d] = self.p_t_rfmab[d].calc_ceil(t_ck)
                self.t_rfcpb[d] = self.p_t_rfcpb[d].calc_ceil(t_ck)
                self.t_rfmpb[d] = self.p_t_rfmpb[d].calc_ceil(t_ck)
                self.t_pbr2pbr[d] = self.p_t_pbr2pbr[d].calc_ceil(t_ck)
                self.tx_pbr2pbr[d] = min(self.t_rfcpb[d] - self.t_pbr2pbr[d], 255)
                self.t_xsr  [d] = self.p_t_xsr  [d].calc_ceil(t_ck)
                if self.args.dram_type == 'lpddr5':
                    self.t_xsr[d] = self.t_rfcab[d] + self.t_xsr[d]
                if self.args.txsr_as_1st_ed:
                    self.t_xsr[d] += 2
                self.t_refdpr[d] = self.t_rfcab[d]//2
                self.t_xsdll[d] = 0
                self.t_xs_fast[d] = 0
                if self.t_refdpr[d] > 255:
                    self.t_refdpr[d] = 255
                elif self.t_refdpr[d] < 10:
                    self.t_refdpr[d] = 0
                else:
