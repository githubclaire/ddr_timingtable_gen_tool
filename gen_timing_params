def get_type_format_list():
    type_format_list = []
    for type_str in type_arr:
        # > big-endian
        # > small-endian
        type_format_list.append(type_mapping[' '.join(type_str.split(' ')[:-1])])
    return type_format_list

def gen_timingtable_bin(my_values):
    type_format_list = get_type_format_list()
    byte_str = b''
    value_list = []
    format_list = ""

    for c_values in my_values:
        c_values = c_values[1:-1]  # 去掉最外层括号
        c_values = c_values.replace('\n', '')
        c_values = c_values.replace('      ', '')
        c_values = c_values.replace(' ', '')
        c_values = c_values.split(',')
        brace_flag = 0
        i = 0  # format index
        for c_value in c_values:
            old_val = c_value
            if c_value.startswith('{'):
                brace_flag += 1  # 最多只有两层，进入第二层
                c_value = c_value[1:]
            if c_value.endswith('}'):
                c_value = c_value[:-1]
                brace_flag -= 1  # 退出第二层
            if c_value.startswith('0x'):
                c_value = int(c_value, 16)
            else:
                c_value = int(c_value)

            type_format = type_format_list[i]
            if brace_flag == 0:
                i = i + 1
            try:
                value_list.append(c_value)
                format_list += type_format
            except Exception as e:
                print(i, old_val, c_value, type(c_value), type_format, brace_flag)
                print(type_format_list[i])
                print(e)
                break
    byte_str += struct.pack(format_list, *value_list)
    # if not os.path.exists("../../out/bin/"):
    #     os.makedirs("../../out/bin/")
    # with open('../../out/bin/ddr_timing_table.bin', 'wb') as f:
    #     f.write(byte_str)
    with open('ddr_timing_table.bin', 'wb') as f:
        f.write(byte_str)


def generate_orbit_config_bin(args):
    """Generate orbit_config binary and write at offset 0x800."""
    if args.orbit_config_use_python:
        # Use Python implementation
        try:
            from ddr_config_init import generate_orbit_config_binary
        except ImportError as e:
            print("Error: Python orbit config modules not found:", e)
            sys.exit(1)
        
        # Density fixed to 16 per customer spec (line 72 of ddr_config.h)
        density = 16
        
        # Collect modifiable field overrides from CLI arguments
        overrides = {}
        # Map argument names to orbit_config field names
        field_map = {
            'orbit_byte_mode': 'byte_mode',
            'orbit_mixed': 'mixed',
            'orbit_rank_interleaving': 'rank_interleaving',
            'orbit_num_rank': 'num_rank',
            'orbit_reboot_with_mrw': 'reboot_with_mrw',
            'orbit_rfm_en': 'rfm_en',
            'orbit_dsm_en': 'dsm_en',
            'orbit_ca_odt': 'ca_odt',
        }
        for arg_name, field_name in field_map.items():
            if hasattr(args, arg_name):
                overrides[field_name] = getattr(args, arg_name)
        
        # Compute density_code matching C logic (index in orbit_densities list)
        orbit_densities = list(args.densities) if args.densities else []
        if 16 not in orbit_densities:
            orbit_densities.append(16)
        density_code = orbit_densities.index(16)
        overrides['density_code'] = density_code
        
        # Additional overrides from JSON file
        if args.orbit_config_json:
            with open(args.orbit_config_json, 'r') as f:
                json_overrides = json.load(f)
                # Convert keys to match struct field names (same as JSON keys)
                overrides.update(json_overrides)
        
        # Convert dram_type string to match Python expectation
        dram_type = args.dram_type  # 'lpddr4' or 'lpddr5'
        two_channel = args.two_channel
        
        # Extract byte_mode and mixed from overrides to avoid duplicate keyword arguments
        byte_mode = overrides.pop('byte_mode', 0)
        mixed = overrides.pop('mixed', 0)
        print(f"Generating orbit config using Python: dram_type={dram_type}, two_channel={two_channel}, density={density}")
        generate_orbit_config_binary(dram_type=dram_type,
                                     two_channel=two_channel,
                                     density=density,
                                     byte_mode=byte_mode,
                                     mixed=mixed,
                                     output_file='ddr_timing_table.bin',
                                     offset=0x800,
                                     **overrides)
        print("Python orbit config generation completed.")
    else:
        # Use original C implementation via gen_ddr_config
        import subprocess
        macro_ddr_type = args.macro_ddr_type
        macro_two_channel = 1 if args.two_channel else 0
        script_path = os.path.join(os.path.dirname(__file__), 'gen_ddr_config')
        cmd = [sys.executable, script_path, str(macro_ddr_type), str(macro_two_channel)]
        print(f"Running: {' '.join(cmd)}")
        result = subprocess.run(cmd)
        if result.returncode != 0:
            print("Error: gen_ddr_config failed")
            sys.exit(result.returncode)


