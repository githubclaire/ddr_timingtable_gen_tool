            self.t_mrw = self.p_t_mrw.calc_ceil(t_ck)
            self.t_mod = self.p_t_mod.calc_ceil(t_ck)
            self.t_mrr = self.p_t_mrr.calc_ceil(t_ck)
            self.t_wtr = self.p_t_wtr.calc_ceil(t_ck)

            self.t_rcd = self.p_t_rcd.calc_ceil(t_ck)
            self.t_rcdwr = self.p_t_rcdwr.calc_ceil(t_ck)

            self.t_rcd = self.delay_t_rcd(t_ck,self.t_rcd,self.t_rrd)
            self.t_rcdwr = self.delay_t_rcd(t_ck,self.t_rcdwr,self.t_rrd)

            self.tx_rcdwr = self.t_rcd - self.t_rcdwr

            self.t_wr = self.p_t_wr.calc_ceil(t_ck)
            self.t_zqcs = self.p_t_zqcs.calc_ceil(t_ck)
            self.t_zqcl = self.p_t_zqcl.calc_ceil(t_ck)
            self.t_xp_mrri = self.p_t_xp_mrri.calc_ceil(t_ck)

            self.t_rc_derate = self.p_t_rc_derate.calc_ceil(t_ck)
            self.t_ras_derate = self.p_t_ras_derate.calc_ceil(t_ck)
            self.t_rrd_derate = self.p_t_rrd_derate.calc_ceil(t_ck)
            self.t_rpab_derate = self.p_t_rpab_derate.calc_ceil(t_ck)
            self.t_rppb_derate = self.p_t_rppb_derate.calc_ceil(t_ck)

            self.t_rcd_derate = self.p_t_rcd_derate.calc_ceil(t_ck)
            self.t_rcdwr_derate = self.p_t_rcdwr_derate.calc_ceil(t_ck)

            self.t_rcd_derate = self.delay_t_rcd(t_ck,self.t_rcd_derate,self.t_rrd_derate)
            self.t_rcdwr_derate = self.delay_t_rcd(t_ck,self.t_rcdwr_derate,self.t_rrd_derate)

            self.tx_rcdwr_derate = self.t_rcd_derate - self.t_rcdwr_derate

            self.t_cslck = self.p_t_cslck.calc_ceil(t_ck)
            self.t_pbr2act = self.p_t_pbr2act.calc_ceil(t_ck)

            self.dram.calculate(t_ck)
            self.phy.calculate_mc_timing_param(t_ck)
            self.t_wtrcr = max(self.t_wtrcr, 0)

            self.phy.calculate_phy_timing_param(t_ck)
            # update timing paramters for write odt incase of lpddr4
            if self.args.dram_type in ('lpddr4',) and self.write_odt:
